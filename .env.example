# Required for production launch. Set in Vercel → Project → Settings → Environment Variables.
# Do not commit real values here.

# Applies to /api/unlock on the 2027 landing gate.
DEMO_PASSWORD=

# Applies to /api/telegram-webhook — the Telegram bot that DMs the code to
# channel subscribers. Get TELEGRAM_BOT_TOKEN from @BotFather.
TELEGRAM_BOT_TOKEN=
# The channel people must subscribe to, e.g. @mossyaps
TELEGRAM_CHANNEL=
# The code the bot sends once it confirms the subscription.
TELEGRAM_UNLOCK_CODE=
# Optional: a random string also passed as secret_token when registering the
# webhook with Telegram, so /api/telegram-webhook can reject requests that
# don't come from Telegram.
TELEGRAM_WEBHOOK_SECRET=
